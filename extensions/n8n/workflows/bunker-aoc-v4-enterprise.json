      "id": "v4-write-audit",
      "parameters": {
        "jsCode": "const e = $json;\nfunction getStore() { try { return $getWorkflowStaticData('global'); } catch (e) { return {}; } }\nconst store = getStore();\nstore.audit = store.audit || [];\n\nstore.audit.push({\n  correlationId: e.correlationId,\n  fingerprint: e.fingerprint,\n  outcome: e.outcome || 'unknown',\n  source: e.source,\n  priority: e.priority,\n  action: e.ai?.action,\n  confidence: e.ai?.confidence,\n  severity: e.notification?.severity,\n  timestamp: new Date().toISOString()\n});\n\n// Keep last 500\nif (store.audit.length > 500) store.audit = store.audit.slice(-500);\n\nreturn [{ json: { ok: true, status: 'audited', correlationId: e.correlationId, auditCount: store.audit.length } }];\n"
