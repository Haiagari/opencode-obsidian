        "jsCode": "const e = $json;\nconst outcome = 'create' in $('Create GitHub Issue').context ? 'created' :\n                'review' in $('Create Review Issue').context ? 'reviewed' :\n                'emergency' in $('Emergency Queue').context ? 'emergency' : 'duplicate';\n\nreturn [{\n  json: {\n    ...e,\n    outcome,\n    notification: {\n      title: e.title,\n      severity: e.ai?.action === 'emergency' ? 'CRITICAL' : e.priority === 'high' ? 'WARNING' : 'INFO',\n      summary: outcome === 'created' ? 'Issue creado' :\n               outcome === 'reviewed' ? 'Requiere revision' :\n               outcome === 'emergency' ? 'Encolado urgente' : 'Descartado (duplicado)',\n      correlationId: e.correlationId\n    }\n  }\n}];\n"
