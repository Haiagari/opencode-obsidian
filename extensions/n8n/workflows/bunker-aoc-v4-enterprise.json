    {
      "id": "v4-ingress",
      "parameters": {
        "jsCode": "const item = $input.first().json;\n\nfunction slug(v) {\n  return String(v || 'unknown').toLowerCase().normalize('NFD').replace(/[\\u0300-\\u036f]/g, '').replace(/[^a-z0-9._-]+/g, '-').replace(/^-+|-+$/g, '') || 'unknown';\n}\nfunction hash(v) {\n  let h = 5381;\n  const t = String(v || '');\n  for (let i = 0; i < t.length; i++) h = ((h << 5) + h) + t.charCodeAt(i);\n  return (h >>> 0).toString(16).padStart(8, '0');\n}\n\nconst headers = $execution?.context?.webhook?.headers || item.headers || {};\nconst body = item.body || item;\nconst correlationId = headers['x-correlation-id'] || body.correlationId || hash(JSON.stringify(body) + Date.now());\nconst source = headers['x-aoc-source'] || body.source || 'webhook';\nconst fingerprint = hash(JSON.stringify(body));\n\nreturn [{\n  json: {\n    okToProceed: true,\n    correlationId,\n    fingerprint,\n    source,\n    title: body.title || body.name || 'Untitled Event',\n    description: body.description || body.message || '',\n    priority: body.priority || 'medium',\n    raw: body,\n    ingressAt: new Date().toISOString()\n  }\n}];\n"
      },
      "name": "Ingress Guard",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        280,
        240
      ]
    },
    {
      "id": "v4-valid-if",
      "parameters": {
