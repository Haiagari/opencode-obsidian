        "jsCode": "function getStore() { try { return $getWorkflowStaticData('global'); } catch (e) { return {}; } }\nconst store = getStore();\nstore.emergency = store.emergency || [];\n\nconst now = Date.now();\nlet idx = -1;\nfor (let i = 0; i < store.emergency.length; i++) {\n  const q = store.emergency[i];\n  if ((q.retryCount || 0) < (q.maxRetries || 5) && Date.parse(q.nextRetryAt || q.queuedAt || 0) <= now) {\n    idx = i; break;\n  }\n}\n\nif (idx === -1) {\n  return [{ json: { hasEmergencyWork: false, status: 'idle' } }];\n}\n\nconst item = store.emergency.splice(idx, 1)[0];\nreturn [{ json: { ...item, triggerType: 'reprocessor', hasEmergencyWork: true, pipelineStage: 'reprocessor_loaded' } }];\n"
      },
      "name": "Load Emergency Item",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        840,
        700
      ]
