    {
      "id": "v4-redis-dedup",
      "parameters": {
        "jsCode": "// Redis Idempotency Check (usa staticData como placeholder)\n// En produccion reemplazar con Redis node\nconst e = $json;\nfunction getStore() { try { return $getWorkflowStaticData('global'); } catch (e) { return {}; } }\nconst store = getStore();\nstore.ledger = store.ledger || {};\n\nconst dedupKey = 'aoc:' + e.fingerprint;\nconst existing = store.ledger[dedupKey];\nif (existing) {\n  return [{ json: { ...e, idempotency: { replay: true, replayRecord: existing, dedupKey } } }];\n}\n\nstore.ledger[dedupKey] = { correlationId: e.correlationId, status: 'processing', ingressAt: e.ingressAt };\n// Prune ledger older than 100 entries\nconst keys = Object.keys(store.ledger);\nif (keys.length > 100) {\n  for (const k of keys.slice(0, keys.length - 100)) delete store.ledger[k];\n}\n\nreturn [{ json: { ...e, idempotency: { replay: false, dedupKey } } }];\n"
      },
      "name": "Redis Idempotency",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        840,
        160
      ]
