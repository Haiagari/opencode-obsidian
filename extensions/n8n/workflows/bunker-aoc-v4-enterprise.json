      "id": "v4-emergency-queue",
      "parameters": {
        "jsCode": "const e = $json;\nfunction getStore() { try { return $getWorkflowStaticData('global'); } catch (e) { return {}; } }\nconst store = getStore();\nstore.emergency = store.emergency || [];\n\nstore.emergency.push({\n  ...e,\n  retryCount: 0,\n  maxRetries: Number($env.AOC_MAX_RETRIES || 5),\n  nextRetryAt: new Date(Date.now() + 300000).toISOString(),  // 5 min\n  queuedAt: new Date().toISOString()\n});\n// Max 50 items\nif (store.emergency.length > 50) store.emergency = store.emergency.slice(-50);\n\nreturn [{ json: { ok: true, status: 'emergency_queued', correlationId: e.correlationId } }];\n"
