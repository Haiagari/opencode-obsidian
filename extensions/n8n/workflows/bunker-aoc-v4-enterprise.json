    {
      "id": "v4-ai-parse",
      "parameters": {
        "jsCode": "const e = $('Redis Idempotency').first().json;\nconst response = $json || {};\nlet action = 'review';\nlet confidence = 0;\nlet reason = 'AI fallback: parse error';\n\ntry {\n  const text = response.choices?.[0]?.message?.content || response.response || JSON.stringify(response);\n  const parsed = JSON.parse(text.replace(/```json|```|\\n/g, '').trim());\n  const allowedActions = ['create', 'review', 'duplicate', 'emergency'];\n  const parsedConfidence = parsed.confidence;\n\n  if (allowedActions.includes(parsed.action)\n      && typeof parsedConfidence === 'number'\n      && Number.isFinite(parsedConfidence)) {\n    action = parsed.action;\n    confidence = Math.max(0, Math.min(1, parsedConfidence));\n    reason = typeof parsed.reason === 'string' ? parsed.reason : '';\n  } else {\n    reason = 'AI fallback: invalid action or confidence; human review required';\n  }\n} catch (err) {\n  // Fail closed: malformed or unavailable AI output routes to human review.\n}\n\nreturn [{ json: { ...e, ai: { action, confidence, reason } } }];\n"
      },
      "name": "Parse AI Decision",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
