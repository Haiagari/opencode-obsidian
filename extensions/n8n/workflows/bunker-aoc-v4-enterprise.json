      "parameters": {
        "method": "POST",
        "url": "={{ $env.OPENROUTER_API_KEY ? 'https://openrouter.ai/api/v1/chat/completions' : 'http://localhost:11434/api/generate' }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "model",
              "value": "={{ $env.OPENROUTER_API_KEY ? 'mistralai/mistral-7b-instruct:free' : 'llama3.2' }}"
            },
            {
              "name": "messages",
              "value": "={{ [ { role: 'system', content: 'Eres un triage de seguridad. Clasifica el evento en UNA de estas acciones:\\n- create: crear issue nuevo\\n- review: necesita revision humana\\n- duplicate: es duplicado\\n- emergency: critico, encolar urgente\\n\\nResponde SOLO con el nombre de la accion en JSON: {\"action\": \"...\", \"confidence\": 0-1, \"reason\": \"...\"}' }, { role: 'user', content: 'Evento: ' + JSON.stringify({ title: $json.title, description: $json.description, priority: $json.priority, source: $json.source }) } ] | toJson }}"
            },
            {
              "name": "temperature",
              "value": 0.1
            }
          ]
        },
        "options": {
          "timeout": 15000
        },
        "sendQuery": false,
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ $env.OPENROUTER_API_KEY ? 'Bearer ' + $env.OPENROUTER_API_KEY : '' }}"
            }
          ]
        }
      },
      "name": "AI Triage",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1400,
        240
      ],
      "continueOnFail": true
