# Optional Bunker n8n settings currently read by the workflow or alert sender.
# The alert sender uses this to sign outbound requests. The current n8n receiver
# does not validate the signature; this secret is not receiver authentication.
AOC_WEBHOOK_SECRET=replace_with_a_unique_random_secret
AOC_MAX_RETRIES=5

# Optional AOC integrations
OPENROUTER_API_KEY=replace_with_openrouter_api_key
GITHUB_OWNER=Haiagari
GITHUB_REPO=opencode-obsidian
# SLACK_AOC_CHANNEL_ID=your_slack_channel_id
# TELEGRAM_AOC_CHAT_ID=your_telegram_chat_id
# DISCORD_AOC_WEBHOOK_URL=your_discord_webhook_url
