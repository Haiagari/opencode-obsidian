# ──────────────────────────────────────────
# Bunker n8n — Environment Example Template
# ──────────────────────────────────────────

# --- AI APIs ---
# GOOGLE_API_KEY=your_google_ai_studio_api_key_here
# OPENROUTER_API_KEY=your_openrouter_api_key_here

# --- AOC Security & Webhooks ---
AOC_WEBHOOK_SECRET=replace_with_secure_random_hmac_secret_key_32_bytes_min
AOC_MAX_PAYLOAD_BYTES=200000
AOC_RATE_LIMIT_PER_MINUTE=60
AOC_DRY_RUN=true
AOC_MAX_RETRIES=5
GITHUB_OWNER=sambleed
GITHUB_REPO=opencode-obsidian
AGENTMEMORY_URL=http://host.docker.internal:3111/agentmemory/smart-search
AOC_MEMORY_LIMIT=5
AOC_MEMORY_STRONG_SCORE=0.80
AOC_MEMORY_WEAK_SCORE=0.60
# SLACK_AOC_CHANNEL_ID=your_slack_channel_id_here
# TELEGRAM_AOC_CHAT_ID=your_telegram_chat_id_here

# --- n8n Production Concurrency & Tuning ---
N8N_CONCURRENCY_PRODUCTION_LIMIT=20
EXECUTIONS_DATA_PRUNE=true
EXECUTIONS_DATA_MAX_AGE=168
EXECUTIONS_DATA_PRUNE_MAX_COUNT=50000
N8N_DEFAULT_BINARY_DATA_MODE=filesystem
